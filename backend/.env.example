# Server Configuration
# 端口号，例如 :8080
SERVER_PORT=:8080
# 运行模式: debug, release, test
SERVER_MODE=debug

# Internal API Secret (service-to-service auth between Go backend and Python AI Agent)
# Must match INTERNAL_API_SECRET in backend/ai-agent/.env
INTERNAL_API_SECRET=dev_internal_secret_please_change_in_production

# JWT Configuration
# JWT 签名密钥（必须至少 32 位）
JWT_SECRET=please_change_to_a_long_random_secret_at_least_32_chars

# Database Configuration (PostgreSQL)
# 数据库主机地址
DB_HOST=localhost
# 数据库端口
DB_PORT=5432
# 数据库用户名
DB_USER=postgres
# 数据库密码
DB_PASSWORD=password
# 数据库名称
DB_NAME=advertising_image
# SSL模式: disable, require, verify-ca, verify-full
DB_SSLMODE=disable

# Redis Configuration
# Redis 地址
REDIS_ADDR=localhost:6379
# Redis 密码 (如果无密码留空)
REDIS_PASSWORD=
# Redis 数据库索引 (0-15)
REDIS_DB=0

# Alibaba Cloud Vision API Configuration
# 阿里云 AccessKey ID
ALIBABA_CLOUD_ACCESS_KEY_ID=
# 阿里云 AccessKey Secret
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# STP Renderer Configuration
# 统一 Python 环境：同时安装 pythonocc-core 和 open3d
# Python 解释器路径（需要 pythonocc-core 和 open3d）
STP_WORKER_PYTHON=/opt/miniconda3/envs/py312/bin/python
# STP Renderer 目录（留空则自动使用 Go 后端工作目录下的 stp-renderer）
STP_WORKER_PATH=
